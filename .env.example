# Copy this file to .env (same folder) and fill in your GitHub App's settings.
# .env holds the client secret, so it's never committed (it's in .gitignore).
LECTERN_GH_CLIENT_ID=
LECTERN_GH_CLIENT_SECRET=
# The app's name in its address, github.com/apps/<slug> (for the "Install Lectern" link)
LECTERN_GH_APP_SLUG=
# Optional
# LECTERN_APP_URL=https://lectern.changapp.net/
# LECTERN_LEARN_MORE=
