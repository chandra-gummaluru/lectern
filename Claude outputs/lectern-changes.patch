+.dd-t small { font: 700 10.5px/1.3 var(--font-ui) !important; letter-spacing: .08em; text-transform: uppercase; color: #80848b !important; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+.dd-t b { flex: none; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+.dd-h { padding: 8px 10px 3px; font: 700 10.5px var(--font-ui); letter-spacing: .08em; text-transform: uppercase; color: #9fa3aa; }
+.dd-sep { height: 1px; margin: 4px 6px; background: #ecedef; }
+/* menus: items size to their two lines of text */
+.fpop .menu-list button { height: auto; min-height: 0; width: 100%; justify-items: start; align-content: start; line-height: 1.35; }
+.fpop:has(> .menu-list) { width: 320px; padding: 6px; gap: 0; }
+.fpop:has(> .dd-list) { width: auto; min-width: 260px; padding: 6px; gap: 0; }
