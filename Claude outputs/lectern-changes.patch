-  let o = "";
-  if (p[0] && /^~[a-z0-9-]+$/.test(p[0])) { o = p[0].slice(1); p = p.slice(1); }   // someone else's offering (a team you're on)
-  if (S.user && o === S.user.handle) o = "";
