+@media (max-width: 760px) { .erow { flex-direction: column; align-items: stretch; } .er-side { align-items: flex-start; } }
+@media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) .erow { background: var(--bar); border-color: var(--line); color: var(--ink); } :root:not([data-theme="light"]) .er-top h3 { color: var(--ink); } :root:not([data-theme="light"]) .erow p { color: var(--ink-2); } :root:not([data-theme="light"]) .egroup { background: var(--bg); border-color: var(--line); } :root:not([data-theme="light"]) .egroup > .erow.grp { background: var(--bar); } }
+.acc-w { max-width: 260px; margin: 6px 0 0; }
