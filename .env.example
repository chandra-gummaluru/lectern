# Copy this file to .env (same folder) and fill in your GitHub App's settings.
# .env holds the client secret, so it's never committed (it's in .gitignore).
LECTERN_GH_CLIENT_ID=
LECTERN_GH_CLIENT_SECRET=
# The app's name in its address, github.com/apps/<slug> (for the "Install Lectern" link)
LECTERN_GH_APP_SLUG=
# Accommodation requests (see README: "Accommodation requests")
# The GitHub App's private key: on the app's settings page, Credentials → Key pairs → New key; save the .pem beside app.py
# (*.pem is in .gitignore). The Client ID above identifies the app; or set its App ID:
LECTERN_GH_PRIVATE_KEY_FILE=
# LECTERN_GH_APP_ID=
# Email to students (any SMTP login; for Gmail, an app password). Without a host, nothing is sent.
LECTERN_SMTP_HOST=
LECTERN_SMTP_PORT=587
LECTERN_SMTP_USER=
LECTERN_SMTP_PASSWORD=
LECTERN_SMTP_FROM=
# LECTERN_SMTP_SECURITY=starttls   (or ssl, with port 465)
# Request deadlines are in this time zone (default America/Toronto)
# LECTERN_TIMEZONE=America/Toronto
# Behind a proxy (nginx): limit requests by the student's address, not the proxy's
# LECTERN_BEHIND_PROXY=1

# Optional
# LECTERN_APP_URL=https://lectern.changapp.net/
# LECTERN_LEARN_MORE=
