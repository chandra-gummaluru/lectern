+.ab-times { grid-template-columns: 9.5em 8em minmax(0, 1fr); column-gap: 16px; row-gap: 6px; }   /* the same columns in every card, so they line up down the page */
+@media (max-width: 640px) { .ab-times { grid-template-columns: max-content max-content minmax(0, 1fr); } }
+.ab-times > .ab-time { display: contents; }
+.ab-who { margin: 2px 0 0 !important; font-size: 14px !important; color: var(--ink-2) !important; }
+.ab-who + .ab-times { margin-top: 10px; }
+.ab-times.ab-contact { display: flex; flex-wrap: wrap; } .ab-times.ab-contact > .ab-time { display: flex; }
+
+/* About the Course: the week as a calendar (a column a day, an hour a row), each meeting a block. */
+.cal-card { margin-bottom: 26px; padding: 20px 20px 16px; }
+.cal-scroll { overflow-x: auto; }
+.cal { display: grid; grid-template-columns: 52px repeat(var(--n), minmax(96px, 1fr)); min-width: calc(52px + var(--n) * 96px); }
+.cal-h { padding: 0 0 8px; text-align: center; font: 700 11.5px var(--font-ui); letter-spacing: .08em; text-transform: uppercase; color: var(--ink-3); }
+.cal-times { position: relative; }
+.cal-times span { position: absolute; right: 8px; transform: translateY(-50%); font-size: 11.5px; color: var(--ink-3); font-variant-numeric: tabular-nums; }
+.cal-times span:first-child { transform: none; }
+.cal-day { position: relative; border-left: 1px solid var(--line); }
+.cal-day:last-child { border-right: 1px solid var(--line); }
+.cal-day > i { position: absolute; left: 0; right: 0; border-top: 1px solid var(--line); }
+.cal-ev { position: absolute; display: grid; align-content: start; gap: 1px; padding: 5px 7px; overflow: hidden; border: 0; border-left: 3px solid var(--k); border-radius: 6px; background: color-mix(in srgb, var(--k) 14%, var(--card)); text-align: left; font: 12px/1.3 var(--font-ui); color: var(--ink-2); cursor: pointer; }
+.cal-ev b { font-weight: 700; color: var(--ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+.cal-ev span { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+.cal-ev:hover, .cal-ev.on { background: color-mix(in srgb, var(--k) 26%, var(--card)); }
+.cal-ev.on { box-shadow: 0 0 0 2px var(--k); }
+.k-lecture { --k: #b58a00; } .k-tutorial { --k: #3a6ea5; } .k-lab { --k: #2f8f5b; } .k-office { --k: #8a8f98; } .k-other { --k: #8a6db5; }
+.cal-more { margin-top: 14px; }
+.cal-hint { margin: 0; font-size: 13.5px; color: var(--ink-3); }
+.cal-key { display: flex; flex-wrap: wrap; gap: 6px 16px; margin-top: 12px; font-size: 12.5px; color: var(--ink-3); }
+.cal-key span { display: inline-flex; align-items: center; gap: 6px; } .cal-key i { width: 10px; height: 10px; border-radius: 3px; background: var(--k); }
+.cal-day { border-bottom: 1px solid var(--line); }
+
+/* The calendar in the course page's own colours: each meeting off-white, the signed-in student's own yellow. */
+.cal-ev { border: 1px solid var(--line-2) !important; border-radius: 7px; background: var(--strip) !important; color: var(--ink-2); }
+.cal-ev:hover, .cal-ev.on { background: color-mix(in srgb, var(--ink) 6%, var(--strip)) !important; }
+.cal-ev.on { box-shadow: 0 0 0 2px var(--ink-3); }
+.cal-ev.mine { background: var(--accent-bg) !important; border-color: var(--accent-line) !important; }
+.cal-ev.mine:hover, .cal-ev.mine.on { background: color-mix(in srgb, var(--accent) 22%, var(--card)) !important; }
+.cal-ev.mine.on { box-shadow: 0 0 0 2px var(--accent); }
+.cal-ev b { display: flex; align-items: center; gap: 4px; }
+.cal-ic { flex: none; display: inline-grid; color: var(--ink-3); } .cal-ic svg { width: 12px; height: 12px; }
+.cal-key i { background: var(--accent-bg) !important; box-shadow: inset 0 0 0 1px var(--accent-line); }
+.ab-desc { margin: -6px 0 22px; font-size: 15.5px; color: var(--ink-2); }
+.ab-desc .hb-md > :last-child { margin-bottom: 0; }
+
+/* My Requests: each request in the Item Head style (docs/ui-patterns.md), its decision as a comment. */
+.ma-head { display: grid; grid-template-columns: auto 1fr auto; gap: 0 6px; align-items: center; }
+.ma-head .ma-kic { grid-column: 1; grid-row: 1; display: grid; place-items: center; width: 15px; height: 15px; color: var(--ink-3); }
+.ma-head .ma-kic svg { width: 15px; height: 15px; stroke-width: 2.1; }
+.ma-head .hs-kick { grid-column: 2; grid-row: 1; margin: 0; }
+.ma-head h3 { grid-column: 1 / 3; grid-row: 2; margin: 1px 0 0; line-height: 1.12; }
+.ma-head .ma-facts { grid-column: 1 / 3; grid-row: 3; margin: 2px 0 0; font-size: 14.5px; color: var(--ink-3); }
+.ma-pill { grid-column: 3; grid-row: 1 / span 3; align-self: center; padding: 3px 12px; border-radius: 999px; font: 600 13px/20px var(--font-ui); box-shadow: inset 0 0 0 1px currentColor; color: #9a7400; }
+.ma-pill.v-approved, .ma-v.v-approved { color: #2f8f5b; } .ma-pill.v-rejected, .ma-v.v-rejected { color: #c0392b; }
+.ma-req .hs-body { margin-top: 10px; }
+.ma-cmt { display: flex; gap: 12px; align-items: flex-start; margin-top: 14px; }
+.ma-av { flex: none; display: grid; place-items: center; width: 30px; height: 30px; border-radius: 50%; background: color-mix(in srgb, var(--accent-bg) 70%, var(--card)); box-shadow: inset 0 0 0 1px var(--accent-line); font: 600 11px var(--font-ui); color: var(--accent); }
+.ma-cb { flex: 1; min-width: 0; }
+.ma-ch { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 8px; margin: 4px 0 0; font-size: 13px; color: var(--ink-3); }
+.ma-ch b { font-size: 14px; font-weight: 600; color: var(--accent); }
+.ma-v { font: 600 12.5px var(--font-ui); }
+.ma-cn { margin-top: 3px; font-size: 15px; line-height: 1.55; color: var(--ink); }
