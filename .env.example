# Copy this file to .env (same folder) and fill it in. .env is never committed (it's in .gitignore).

# Where Lectern lives. Required on a real server: links in emails (invitations, password resets) use
# only this address, and requests for any other host name are refused.
LECTERN_APP_URL=
# Behind nginx (which handles HTTPS): trust its X-Forwarded-For / X-Forwarded-Proto. Lectern must then
# listen only on 127.0.0.1 (the default), so nothing reaches it except through nginx.
# LECTERN_BEHIND_PROXY=1

# Where accounts and everyone's files are kept (default: data/ beside app.py). Back it up, secret.key too.
# LECTERN_DATA_DIR=
# The server's own key (two-factor secrets, recovery codes). When unset, one is made in the data folder.
# LECTERN_SECRET_KEY=

# Email (invitations, password resets, security notices, students' receipts). Any SMTP login;
# for Gmail, an app password. Without a host, nothing is sent.
LECTERN_SMTP_HOST=
LECTERN_SMTP_PORT=587
LECTERN_SMTP_USER=
LECTERN_SMTP_PASSWORD=
LECTERN_SMTP_FROM=
# LECTERN_SMTP_SECURITY=starttls   (or ssl, with port 465)
# Only on your own computer, without SMTP: print emails (with their links) to the log
# LECTERN_PRINT_EMAILS=1

# Sessions: end after this long unused / at most this long (defaults 12 hours, 7 days)
# LECTERN_SESSION_IDLE_HOURS=12
# LECTERN_SESSION_DAYS=7
# Each account's space, old versions included (default 2048 MB), and the most one save can upload (64 MB)
# LECTERN_QUOTA_MB=2048
# LECTERN_MAX_UPLOAD_MB=64
# Published course pages from another address (pointing at this server's /p/), for more separation
# LECTERN_PAGES_URL=https://pages.lectern.changapp.net/

# Teaching team invitations may make new accounts only for these email domains (unset: any)
# LECTERN_TEAM_DOMAINS=utoronto.ca

# Request deadlines are in this time zone (default America/Toronto)
# LECTERN_TIMEZONE=America/Toronto

# Optional
# LECTERN_INSTITUTION=University of Toronto
# LECTERN_LEARN_MORE=
