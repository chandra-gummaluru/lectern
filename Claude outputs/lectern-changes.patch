-  b.course = Object.assign({ code: "", term: "" }, b.course || {});
-  b.evals = (b.evals || []).map(e => {
-    const n = Object.assign(newEval(), e);
-    delete n.late;
-    n.missed = Object.assign(newEval().missed, e.missed || {});
