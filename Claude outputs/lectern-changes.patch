+.sp-row { grid-template-columns: minmax(120px, 190px) minmax(0, 1fr) 200px; }
+.sp-v small { white-space: normal; text-align: right; }
+
+.bhist .bh-empty-note { font: 13px var(--font-ui); fill: #9fa3aa; }
+.sp-card h3, .scard h3 { display: flex; align-items: baseline; gap: 10px; }
+
+/* Statistics: dropdown buttons (with the evaluation's circle) and their lists */
+.dd-btn { display: inline-flex; align-items: center; gap: 9px; height: 40px; padding: 0 12px 0 14px; border-radius: 9px; border: 1px solid #b4b6ba; background: #fff; font: 600 16px var(--font-ui); color: #1f2329; cursor: pointer; }
+.dd-btn:hover { border-color: #7a7f87; }
+.dd-btn .dot { width: 11px; height: 11px; }
+.dd-btn svg { width: 15px; height: 15px; margin-left: 4px; color: #7a7f87; }
+.dd-pop { min-width: 260px; padding: 6px; }
+.dd-list { display: grid; gap: 1px; max-height: 60vh; overflow: auto; }
+.dd-list button { display: flex; align-items: center; gap: 10px; width: 100%; padding: 9px 10px; border: 0; border-radius: 7px; background: transparent; text-align: left; font: 14px var(--font-ui); color: #1f2329; cursor: pointer; }
+.dd-list button:hover { background: #f6f5f2; }
