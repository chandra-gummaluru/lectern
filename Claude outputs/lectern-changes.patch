+
+/* An evaluation as a title: Test 1 / Midterm Test (the title part gray). */
+.ec-of { color: var(--ink-3); }
+
+/* A meeting's details: over the calendar, the same size, with Back. */
+.cal-stage { position: relative; }
+.cal-stage.open .cal-scroll { visibility: hidden; }
+.cal-det { position: absolute; inset: 0; display: flex; flex-direction: column; gap: 0; padding: 2px 4px; overflow: auto; background: var(--card); }
