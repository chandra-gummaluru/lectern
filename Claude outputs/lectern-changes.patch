+.mr-reply-btn svg { width: 17px; height: 17px; }
+.mr-compose { display: grid; gap: 10px; }
+.mr-foot { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
+.mr-note { flex: 1; min-width: 140px; font-size: 13px; color: var(--ink-3); }
+.mr-compose .rq-err:empty { display: none; }
+.rq-page .ec-head > .ma-pill { align-self: center; }
+#mr-card .ec-head + .ec-sec { margin-top: 22px; padding-top: 16px; border-top: 1px solid var(--line); }
+
+/* My Student ID */
+
+/* The teaching team, previewing: which view (Student / Public) where the account is. */
+.hb .hb-view .hb-view-l { font-weight: 500; color: var(--ink-3); margin-right: -2px; }
+.hb .hb-view-menu a { display: grid; gap: 1px; }
+.hb .hb-view-menu a b { font-weight: 600; } .hb .hb-view-menu a span { font-size: 12.5px; color: var(--ink-3); }
+.hb .hb-view-menu a[aria-checked="true"] b::after { content: " ✓"; color: var(--accent); }
+.hb .dc-ro { cursor: default; }
+
+/* ── Phones (from the mobile audit) ──
+   Who's signed in (or Sign in) goes on its own row above the course name, so the name has the whole width
+   and wraps instead of ending in "…"; the term and school stay on one line under it. Menus stay on the screen,
+   with taller rows to tap. Fields are 16px, so phones don't zoom in on them. */
+@media (max-width: 640px) {
+  .hb-head-in.hb-head-in { flex-wrap: wrap; row-gap: 10px; padding-top: 14px; }
+  .hb-head .hb-who { order: -1; flex: 1 1 100%; padding-top: 0; justify-content: flex-end; }
+  .hb-head .hb-titles { flex: 1 1 100%; }
+  .hb-head .hb-title { white-space: normal; overflow: visible; font-size: 30px; display: block; }
+  .hb .hb-acct { max-width: 100%; }
+  .hb-menu { max-width: calc(100vw - 32px); }
+  .hb-menu a, .hb-menu button { height: 42px; }
+  .hb-si { width: 100%; padding-top: 40px; }
+  .hb-si-card { padding: 20px 18px; }
+  .hb-si-card input { min-width: 0; width: 100%; }
