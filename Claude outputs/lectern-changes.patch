+.sp-cls { position: absolute; top: 8px; width: 9px; height: 9px; margin-left: -5px; transform: rotate(45deg); border: 2px solid #7a7f87; background: #fff; }
+.sp-none { position: absolute; left: 0; top: 4px; font-size: 12.5px; color: #9fa3aa; }
+.sp-v { display: grid; justify-items: end; line-height: 1.2; }
+.sp-v b { font: 600 18px var(--font-ui); font-variant-numeric: tabular-nums; color: #1f2329; }
