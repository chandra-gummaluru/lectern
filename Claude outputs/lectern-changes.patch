+.sp-axis .sp-track i:first-child { transform: none; } .sp-axis .sp-track i:last-child { transform: translateX(-100%); }
+.sp-whisk { position: absolute; top: 12px; height: 2px; background: color-mix(in srgb, var(--c) 55%, #9fa3aa); border-radius: 1px; }
+.sp-band { position: absolute; top: 6px; height: 14px; border-radius: 4px; background: color-mix(in srgb, var(--c) 35%, #fff); }
+.sp-med { position: absolute; top: 3px; width: 2px; height: 20px; margin-left: -1px; background: #1f2329; border-radius: 1px; }
