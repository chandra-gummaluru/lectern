+.rq-sent-b small { display: block; margin-top: 6px; color: var(--ink-3); font-size: 13px; }
+.hb .hb-btn:disabled { pointer-events: none; }
+
+/* What's new: a count on the account button, and the list in its menu. */
+.hb .hb-acct { position: relative; overflow: visible; }
+.hb-badge { position: absolute; top: -8px; right: -8px; min-width: 20px; height: 20px; padding: 0 6px; box-sizing: border-box; display: grid; place-items: center; border-radius: 10px; background: #c0392b; color: #fff; font: 700 11.5px/1 var(--font-ui); box-shadow: 0 0 0 2px var(--card); }
+.hb-menu .hb-menu-h { margin: 0; padding: 8px 12px 2px; font: 700 11px/1.3 var(--font-ui); letter-spacing: .08em; text-transform: uppercase; color: var(--ink-3); }
+.hb-menu a.hb-upd { display: grid !important; gap: 1px; height: auto; padding: 7px 10px; line-height: 1.3; }
+.hb-menu a.hb-upd b { font-weight: 600; color: var(--ink); }
+.hb-menu a.hb-upd span { font-size: 13px; color: var(--ink-3); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 260px; }
+
+/* About the Course: each section's (and person's) times as a table: the days, the hours and the places in
