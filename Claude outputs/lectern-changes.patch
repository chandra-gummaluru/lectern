+.rq-codef { max-width: 220px; } .rq-codef input { font: 600 20px/1 var(--font-mono, ui-monospace, monospace); letter-spacing: .18em; }
+.rq-confirm .rq-acts .hb-btn + .hb-btn { margin-left: 0; }
+
+/* A request sent (or one already waiting): a row as the evaluation page's Accommodations is, then its buttons. */
+.rq-sent { display: flex; gap: 14px; align-items: flex-start; padding: 16px 18px; border-radius: 10px; background: color-mix(in srgb, var(--ok) 8%, var(--card)); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--ok) 30%, var(--card)); }
+.rq-sent-ic { flex: none; display: grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; background: var(--ok); color: #fff; }
+.rq-sent-ic svg { width: 16px; height: 16px; stroke-width: 2.6; }
