-// A student's notes: a dated record, oldest first. (An older book kept one block of text: it becomes one undated note.)
-const noteList = v => Array.isArray(v) ? v.filter(n => n && String(n.text || "").trim()).map(n => ({ at: String(n.at || ""), text: String(n.text) }))
-  : String(v || "").trim() ? [{ at: "", text: String(v).trim() }] : [];
