-// ══ The gradebook (saved as grades.json) ════════════════════════════════
-// Evaluations have a total in points, a default weight (%) and what happens
-// when a student doesn't submit (marks come in already final, so there's no
-// late penalty here). Marks are points out of the total, kept per student
-// number. Any policy can be overridden for one student.
-//
-//   missed: { mode: "zero" | "reweight", to: [{ id, share }], split: "custom" }
-//     reweight: each "to" evaluation gets its share (% of the weight); what isn't moved stays, counting as zero.
-//     (Older "by weight" / "equal" splits are turned into the same shares on open.)
-//   missed.makeups: [{ id, share }]: makeups, each worth its share (% of the weight). A makeup is an
-//   evaluation of its own (made first, then chosen here; it gets makeupFor = the original) that only
-//   counts for students who don't submit the original. Makeups and moved shares together should make
-//   up all of the weight; what they don't cover counts as zero. A makeup never counts by itself.
-//
-//   groups: [{ id, name, short, weight, keep, members: [evalId] }]
-//     "best keep of members": each student's best `keep` members count, each worth weight / keep;
-//     the rest aren't counted. A member's own weight and missed policy aren't used (not submitted = 0).
-const MISSED_MODES = { zero: "Zero", reweight: "Reweight" };
-const SPLITS = { weight: "In proportion to their weights", equal: "Equally", custom: "Custom" };
-const newEval = (name = "New evaluation", short = "") => ({
-  id: uid(), name, short, total: 10, weight: 10, makeupFor: null,
-  missed: { mode: "zero", to: [], makeups: [], split: "custom" },
-  // What it is: a Test (written at a set time and place) or an Assignment (handed in by a deadline),
-  // a label (Lab, Quiz, Midterm…) its name and number come from, an optional title, and its date:
-  // the test's date and start time, or the assignment's due date and time.
-  type: "assignment", label: "", title: "", date: "", time: "", shortAuto: false,
-});
-// Special grades: a course grade that isn't a percentage.
-const CODES = [["IPR", "In Progress"], ["SDF", "Standing Deferred"], ["INC", "Incomplete"], ["NGA", "No Grade Available"], ["GWR", "Grade Withheld Pending Review"], ["AII", "Academic Integrity Issue"], ["WDR", "Withdrawn"]];
-const codeName = c => (CODES.find(x => x[0] === c) || [c, c])[1];
-const BLANK_POLICIES = () => ({ round: { step: 0, dir: "nearest" }, buckets: [], autofail: [] });
-// Student fields: the identifier (required and unique; its name can be changed), first and
-// last name, and any custom fields. A field called "Section" is the one students can be filtered by.
-const BLANK_FIELDS = () => ({ idLabel: "Student Identifier", emailDomain: "", custom: [{ id: "email", label: "Email" }] });
-const BLANK_BOOK = () => ({ format: "grade-builder/1", course: { code: "", term: "" }, fields: BLANK_FIELDS(), evals: [], groups: [], students: [], marks: {}, overrides: {}, policies: BLANK_POLICIES(), finals: {} });
-const newGroup = () => ({ id: uid(), name: "Assignments", short: "", weight: 20, keep: 1, members: [] });
