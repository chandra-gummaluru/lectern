+.dd-list button { padding: 7px 9px !important; border-radius: 6px !important; font-weight: 400; }
+.dd-list button b { font-weight: 400 !important; }
+.dd-list button[aria-selected="true"] { background: transparent; }
+.dd-list button:hover, .dd-list button:focus-visible { background: #f2f1ee !important; outline: none; }
+.dd-list button > svg:last-child { color: #1f2329 !important; }
+.dd-list .dot.ic { color: #4a4f57 !important; }
+.dd-list button .dot.ic svg { color: #4a4f57 !important; }
+.menu-list .dd-t { font-size: 14px; color: #1f2329; }
