+def term_name(term):
+    """f26 → Fall 2026 (as Lectern names terms)."""
+    m = re.match(r"^([wsf])(\d\d)$", term or "", re.I)
+    return f"{dict(w='Winter', s='Summer', f='Fall')[m.group(1).lower()]} 20{m.group(2)}" if m else term
