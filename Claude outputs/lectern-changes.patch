+.sp-row.sp-axis { border-top: 0; padding: 0 0 2px; }
+.sp-n { display: flex; align-items: center; gap: 8px; font-weight: 600; color: #1f2329; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
