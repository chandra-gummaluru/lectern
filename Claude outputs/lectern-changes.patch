+
+/* My Accommodations: each request a card, its state's icon as in Lectern (approved green, rejected red, waiting yellow). */
+.ma-req .ma-ic { color: #b58a00; } .ma-req.st-approved .ma-ic { color: #2f8f5b; } .ma-req.st-rejected .ma-ic { color: #c0392b; }
